{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null && data.child('teacherUid').val() === auth.uid",
        ".write": "auth != null && !data.exists() && $roomId.matches(/^[A-Z0-9]{6}$/) && newData.hasChildren(['createdAt', 'teacherUid', 'resetVersion', 'reactions', 'note']) && newData.child('teacherUid').val() === auth.uid",
        "createdAt": {
          ".read": false,
          ".validate": "newData.isNumber()"
        },
        "teacherUid": {
          ".read": false,
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "note": {
          ".read": "auth != null && data.parent().child('teacherUid').val() === auth.uid",
          ".write": "auth != null && data.parent().child('teacherUid').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 140"
        },
        "history": {
          ".read": "auth != null && data.parent().child('teacherUid').val() === auth.uid",
          "$historyId": {
            ".write": "auth != null && data.parent().parent().child('teacherUid').val() === auth.uid",
            ".validate": "newData.hasChildren(['label', 'note', 'createdAt', 'counts', 'wow', 'totalResponses', 'participants', 'resetVersion'])",
            "label": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 140"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "counts": {
              "understood": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "lost": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "$other": {
                ".validate": false
              }
            },
            "wow": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "totalResponses": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "participants": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "resetVersion": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "resetVersion": {
          ".read": "auth != null",
          ".write": "auth != null && data.parent().child('teacherUid').val() === auth.uid && newData.isNumber() && newData.val() === data.val() + 1",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "responses": {
          ".read": "auth != null && data.parent().child('teacherUid').val() === auth.uid",
          ".write": "auth != null && data.parent().child('teacherUid').val() === auth.uid && !newData.exists()",
          "$uid": {
            ".read": "auth != null && ($uid === auth.uid || data.parent().parent().child('teacherUid').val() === auth.uid)",
            ".write": "auth != null && $uid === auth.uid && newData.isString() && (newData.val() === 'understood' || newData.val() === 'lost')",
            ".validate": "newData.isString() && (newData.val() === 'understood' || newData.val() === 'lost')"
          }
        },
        "participants": {
          ".read": "auth != null && data.parent().child('teacherUid').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && newData.val() === true",
            ".validate": "newData.val() === true"
          }
        },
        "reactions": {
          "wow": {
            ".read": "auth != null",
            ".write": "auth != null && ((data.parent().parent().child('teacherUid').val() === auth.uid && newData.val() === 0) || (newData.isNumber() && newData.val() === data.val() + 1))",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
